3. FIR Band pass filter having cutoff frequency( 3 KHz, 6 KHz) N=31; Sampling frequency=10
KHz
import numpy as np
import matplotlib.pyplot as plt
from scipy.signal import firwin, freqz
# Increased Fs to 14000 so that Fs/2 (7000) is greater than the 6000 Hz cutoff
Fs = 14000
Fc = [3000, 6000]
N = 31
b = firwin(numtaps=N, cutoff=Fc, window='hann', pass_zero='bandpass', fs=Fs)
f, H = freqz(b, worN=2048, fs=Fs)
magnitude_db = 20 * np.log10(np.maximum(np.abs(H), 1e-10))
plt.plot(f, magnitude_db)
plt.title('FIR Band-Pass Filter (Adjusted Fs)')
plt.xlabel('Frequency (Hz)')
plt.ylabel('Magnitude (dB)')
plt.grid(True)
plt.show()


